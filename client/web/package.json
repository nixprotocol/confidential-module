{
  "name": "confidential-wallet",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "npm run wasm:check && vite",
    "build": "npm run wasm:check && tsc -b && vite build",
    "preview": "vite preview",
    "wasm": "cd wasm && ./build.sh",
    "wasm:check": "node -e \"const fs=require('fs'); const src=fs.statSync('wasm/main.go').mtimeMs; const bin=fs.existsSync('public/crypto.wasm')?fs.statSync('public/crypto.wasm').mtimeMs:0; if(src>bin){console.log('WASM outdated, rebuilding...');process.exit(1);}\" || npm run wasm"
  },
  "dependencies": {
    "@cosmjs/amino": "^0.32.4",
    "@cosmjs/encoding": "^0.32.4",
    "@cosmjs/proto-signing": "^0.32.4",
    "@cosmjs/stargate": "^0.32.4",
    "@cosmjs/tendermint-rpc": "^0.32.4",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sonner": "^1.7.0",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.7.0",
    "vite": "^6.0.0"
  }
}
